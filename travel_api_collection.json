{
	"info": {
		"name": "Travel Company API",
		"description": "API collection for managing travel projects and places.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Projects",
			"item": [
				{
					"name": "Create Project",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Trip to Chicago\",\n  \"description\": \"Art and pizza weekend\",\n  \"start_date\": \"2026-06-01\",\n  \"places\": [\n    {\n      \"external_id\": 129884,\n      \"notes\": \"Must see Starry Night!\"\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/projects",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"projects"
							]
						}
					}
				},
				{
					"name": "Get All Projects",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/projects?skip=0&limit=10",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"projects"
							],
							"query": [
								{
									"key": "skip",
									"value": "0"
								},
								{
									"key": "limit",
									"value": "10"
								}
							]
						}
					}
				},
				{
					"name": "Get Single Project",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/projects/1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"projects",
								"1"
							]
						}
					}
				},
				{
					"name": "Update Project",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Trip to Chicago (Updated)\",\n  \"description\": \"Extended to a full week\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/projects/1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"projects",
								"1"
							]
						}
					}
				},
				{
					"name": "Delete Project (Protected)",
					"request": {
						"auth": {
							"type": "basic",
							"basic": [
								{
									"key": "password",
									"value": "supersecret0000",
									"type": "string"
								},
								{
									"key": "username",
									"value": "login",
									"type": "string"
								}
							]
						},
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/projects/1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"projects",
								"1"
							]
						}
					}
				}
			]
		},
		{
			"name": "Places",
			"item": [
				{
					"name": "Add Place to Project",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"external_id\": 137125,\n  \"notes\": \"Famous painting here\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/projects/1/places",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"projects",
								"1",
								"places"
							]
						}
					}
				},
				{
					"name": "Get Single Place",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/places/1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"places",
								"1"
							]
						}
					}
				},
				{
					"name": "Update Place (Mark Visited)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"notes\": \"It was amazing!\",\n  \"is_visited\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/places/1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"places",
								"1"
							]
						}
					}
				}
			]
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8000",
			"type": "string"
		}
	]
}